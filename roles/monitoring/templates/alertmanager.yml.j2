global:
  resolve_timeout: 5m
{% if alert_email_enabled | bool %}
  smtp_smarthost: "smtp.gmail.com:587"
  smtp_from: "{{ vault_smtp_username }}"
  smtp_auth_username: "{{ vault_smtp_username }}"
  smtp_auth_password: "{{ vault_smtp_password }}"
  smtp_require_tls: true
{% endif %}

route:
  receiver: "{% if alert_email_enabled | bool %}gmail{% else %}null{% endif %}"
  group_by: ["alertname", "peer"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: "null"
{% if alert_email_enabled | bool %}
  - name: "gmail"
    email_configs:
      - to: "{{ vault_alert_email_to }}"
        send_resolved: true
{% endif %}
