options {
    directory "/var/cache/bind";
    listen-on { 127.0.0.1; {{ server_ip }}; };
    listen-on-v6 { none; };
    allow-query { localhost; {{ bind_network_cidr }}; };
    recursion yes;
    allow-recursion { localhost; {{ bind_network_cidr }}; };
    allow-query-cache { localhost; {{ bind_network_cidr }}; };
{% if bind_forwarders | length > 0 %}
    forwarders {
{% for ip in bind_forwarders %}
        {{ ip }};
{% endfor %}
    };
    forward only;
{% endif %}
    dnssec-validation auto;
};
