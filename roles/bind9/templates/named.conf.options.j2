options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };

    allow-query { any; };
    recursion yes;
    allow-recursion { any; };
    allow-query-cache { any; };

{% if bind_forwarders | length > 0 %}
    forwarders {
{% for ip in bind_forwarders %}
        {{ ip }};
{% endfor %}
    };
    forward only;
{% endif %}

    dnssec-validation auto;
};
